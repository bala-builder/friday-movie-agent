# TMDb API Key (Get yours free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API Key (Get yours free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot configuration for weekly recommendations & interactive feedback
# Create a bot with @BotFather and get chat ID with @userinfobot or by messaging your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Streaming filter settings
WATCH_REGION=US
# Provider IDs for base subscription streaming:
# 8 = Netflix, 9 = Amazon Prime Video, 350 = Apple TV Plus, 386 = Peacock
# (Add 15 for Hulu, 337 for Disney+, 1899 for Max if subscribed)
DEFAULT_WATCH_PROVIDERS=8|9|350|386

# Minimum rating threshold (IMDb / TMDb rating)
MIN_RATING=7.5
MIN_VOTE_COUNT=500
